{
  "expo": {
    "name": "Cedar & Loom",
    "slug": "cedar-and-loom",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cedarloom",
    "splash": {
      "backgroundColor": "#f7f5f0"
    },
    "ios": {
      "bundleIdentifier": "com.cedarandloom.store",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cedarandloom.store",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#345747"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "cc059af6-70ae-4cc7-a47a-217c2d941f15"
      }
    },
    "owner": "nou251208740"
  }
}
